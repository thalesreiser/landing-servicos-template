---
import Imagem from './Imagem.astro';
import { atributosAcao } from '../lib/acao.ts';
import { ancoraSecao, type Nicho, type SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'hero'>;
  nicho: Nicho;
}

const { secao, nicho } = Astro.props;
const destaques = secao.destaques ?? [];
// Without an image, the highlights fill the right column on desktop (panel) and become chips
// below the buttons on smaller screens (at most 3). With an image, they are chips everywhere.
const painel = destaques.length > 0 && !secao.imagem;
const chips = secao.imagem ? destaques : destaques.slice(0, 3);
---

{/* data-hero: the WhatsApp shortcut stays hidden while this section is on screen. */}
<section id={ancoraSecao(secao)} class:list={['secao', nicho.tema.fundo_hero === 'malha' && 'hero-malha']} data-hero>
  <div
    class:list={[
      'container-site grid items-center gap-10',
      secao.imagem && 'lg:grid-cols-2',
      painel && 'lg:grid-cols-[1.4fr_1fr] lg:gap-16',
    ]}
  >
    <div>
      {secao.selo && <p class="mb-4 text-sm font-semibold tracking-wide text-primaria uppercase">{secao.selo}</p>}
      <h1
        class:list={[
          'leading-[1.12] font-semibold tracking-tight',
          // Fluid size; without a photo, the type carries the composition and grows larger.
          secao.imagem
            ? 'text-[length:clamp(2rem,1.25rem+3vw,3rem)]'
            : 'text-[length:clamp(2rem,1rem+3.9vw,3.75rem)] lg:max-w-[18ch] lg:leading-[1.05]',
        ]}
      >
        {secao.titulo}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-texto-suave">{secao.subtitulo}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a {...atributosAcao(secao.acao_principal, nicho.contato)} class="botao-primario">
          {secao.acao_principal.texto}
        </a>
        {
          secao.acao_secundaria && (
            <a {...atributosAcao(secao.acao_secundaria, nicho.contato)} class="botao-secundario">
              {secao.acao_secundaria.texto}
            </a>
          )
        }
      </div>
      {
        chips.length > 0 && (
          <dl class:list={['mt-6 flex flex-wrap gap-2 text-sm', painel && 'lg:hidden']}>
            {chips.map((item) => (
              <div class="inline-flex flex-wrap gap-x-1 rounded-botao border border-texto/15 px-3 py-1.5">
                <dt class="text-texto-suave">{item.rotulo}:</dt>
                <dd class="font-semibold">{item.valor}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
    {
      secao.imagem && (
        <Imagem imagem={secao.imagem} prioridade class="aspect-[4/3] w-full rounded-cartao object-cover shadow-lg" />
      )
    }
    {
      painel && (
        <div class="hidden rounded-cartao border border-texto/15 bg-cartao p-8 lg:block">
          <span class="block h-0.5 w-10 bg-destaque" aria-hidden="true" />
          <dl class="mt-2">
            {destaques.map((item) => (
              <div class="border-t border-texto/10 py-4 first:border-t-0 last:pb-0">
                <dt class="text-sm text-texto-suave">{item.rotulo}</dt>
                <dd class="mt-1 font-titulo text-lg font-semibold">{item.valor}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }
  </div>
</section>
