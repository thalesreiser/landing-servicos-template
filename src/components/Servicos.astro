---
import Icone from './Icone.astro';
import { ancoraSecao, type SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'servicos'>;
}

const { secao } = Astro.props;
const idTitulo = `${ancoraSecao(secao)}-titulo`;
---

<section id={ancoraSecao(secao)} class="secao" aria-labelledby={idTitulo}>
  <div class="container-site">
    <h2 id={idTitulo} class="titulo-secao">{secao.titulo}</h2>
    {secao.subtitulo && <p class="mt-4 max-w-2xl text-lg text-texto-suave">{secao.subtitulo}</p>}
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3" data-revelar-grupo>
      {
        secao.itens.map((item, i) => (
          // Phones: icon beside the text, so each card is shorter. From sm: icon on top.
          // Two columns (sm to lg) with an odd count: the last card takes the whole row.
          <li class="cartao relative flex items-start gap-4 sm:block sm:max-lg:odd:last:col-span-2">
            {/* Ghost number drawn by CSS (global.css, .numero-fantasma), so it stays decoration. */}
            {secao.numerar && <span class="numero-fantasma" data-numero={String(i + 1).padStart(2, '0')} aria-hidden="true" />}
            <span class="cartao-icone shrink-0">
              <Icone nome={item.icone} />
            </span>
            <div>
              <h3 class:list={['text-lg font-semibold sm:mt-4 sm:text-xl', secao.numerar && 'max-sm:pr-14']}>{item.titulo}</h3>
              <p class="mt-1 text-[15px] leading-6 text-texto-suave sm:mt-2 sm:text-base">{item.descricao}</p>
              {item.detalhe && <p class="mt-4 border-t border-dotted border-texto/25 pt-3 text-sm font-semibold text-texto-suave">{item.detalhe}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
