---
import Icone from './Icone.astro';
import { ancoraSecao, type SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'servicos'>;
}

const { secao } = Astro.props;
const idTitulo = `${ancoraSecao(secao)}-titulo`;
---

<section id={ancoraSecao(secao)} class="secao" aria-labelledby={idTitulo}>
  <div class="container-site">
    <h2 id={idTitulo} class="titulo-secao">{secao.titulo}</h2>
    {secao.subtitulo && <p class="mt-4 max-w-2xl text-lg text-texto-suave">{secao.subtitulo}</p>}
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {
        secao.itens.map((item) => (
          // Phones: icon beside the text, so each card is shorter. From sm: icon on top.
          <li class="cartao flex items-start gap-4 sm:block">
            <span class="cartao-icone shrink-0">
              <Icone nome={item.icone} />
            </span>
            <div>
              <h3 class="text-lg font-semibold sm:mt-4 sm:text-xl">{item.titulo}</h3>
              <p class="mt-1 text-[15px] leading-6 text-texto-suave sm:mt-2 sm:text-base">{item.descricao}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
