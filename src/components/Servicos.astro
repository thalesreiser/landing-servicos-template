---
import Icone from './Icone.astro';
import { ancoraSecao, type SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'servicos'>;
}

const { secao } = Astro.props;
const idTitulo = `${ancoraSecao(secao)}-titulo`;
---

<section id={ancoraSecao(secao)} class="secao" aria-labelledby={idTitulo}>
  <div class="container-site">
    <h2 id={idTitulo} class="titulo-secao">{secao.titulo}</h2>
    {secao.subtitulo && <p class="mt-4 max-w-2xl text-lg text-texto-suave">{secao.subtitulo}</p>}
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        secao.itens.map((item) => (
          <li class="rounded-xl border border-texto/10 bg-superficie p-6">
            <span class="inline-flex size-12 items-center justify-center rounded-lg bg-primaria/10 text-primaria">
              <Icone nome={item.icone} />
            </span>
            <h3 class="mt-4 text-xl font-semibold">{item.titulo}</h3>
            <p class="mt-2 text-texto-suave">{item.descricao}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
