---
import Icone from './Icone.astro';
import { formatarEndereco, urlAbrirMapa, urlMapa } from '../lib/endereco.ts';
import { ancoraSecao, type Nicho, type SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'mapa'>;
  nicho: Nicho;
}

const { secao, nicho } = Astro.props;
const { endereco, horario, telefone, email } = nicho.contato;
const idTitulo = `${ancoraSecao(secao)}-titulo`;
// The schema guarantees an address whenever embed_url is missing.
const src = secao.embed_url ?? urlMapa(endereco!);
---

<section id={ancoraSecao(secao)} class="secao" aria-labelledby={idTitulo}>
  <div class="container-site grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div>
      <h2 id={idTitulo} class="titulo-secao">{secao.titulo}</h2>
      <ul class="mt-8 space-y-3 text-texto-suave">
        {
          endereco && (
            <li class="flex gap-3">
              <Icone nome="local" class="size-6 shrink-0 text-primaria" />
              <address class="not-italic">{formatarEndereco(endereco)}</address>
            </li>
          )
        }
        {
          horario && (
            <li class="flex gap-3">
              <Icone nome="relogio" class="size-6 shrink-0 text-primaria" />
              <span>
                {horario.map((linha) => (
                  <span class="block">{linha}</span>
                ))}
              </span>
            </li>
          )
        }
        {
          telefone && (
            <li class="flex items-center gap-3">
              <Icone nome="celular" class="size-6 shrink-0 text-primaria" />
              <a href={`tel:+${telefone.replace(/\D/g, '')}`} class="inline-flex min-h-11 items-center hover:text-primaria">
                {telefone}
              </a>
            </li>
          )
        }
        <li class="flex items-center gap-3">
          <Icone nome="email" class="size-6 shrink-0 text-primaria" />
          <a href={`mailto:${email}`} class="inline-flex min-h-11 items-center break-all hover:text-primaria">
            {email}
          </a>
        </li>
      </ul>
      {
        endereco && (
          <a href={urlAbrirMapa(endereco)} target="_blank" rel="noopener" class="botao-secundario mt-8 w-full sm:w-auto">
            <Icone nome="local" class="size-5 shrink-0" />
            Abrir no Google Maps
          </a>
        )
      }
    </div>
    {/*
      Facade: no request reaches Google until the visitor asks for the map (LGPD, and about
      0.5 MB less on the first load). The box keeps its size when the iframe replaces the
      placeholder, so nothing moves. Without JS the button stays hidden and the
      "Abrir no Google Maps" link still works.
    */}
    <div
      class="relative h-80 w-full overflow-hidden rounded-cartao lg:h-full lg:min-h-96"
      data-mapa={src}
      data-mapa-titulo={`Mapa: ${nicho.site.nome}`}
    >
      <div class="mapa-fachada absolute inset-0 grid place-items-center p-4 sm:p-6" data-mapa-fachada>
        <div class="max-w-sm rounded-cartao border border-texto/15 bg-fundo p-5 text-center shadow-sm">
          <Icone nome="local" class="mx-auto size-8 text-primaria" />
          <p class="mt-2 font-semibold">{endereco ? formatarEndereco(endereco) : nicho.site.nome}</p>
          <p class="mt-1 text-sm text-texto-suave">O mapa é do Google Maps e só carrega quando você pedir.</p>
          {/* invisible (not hidden) keeps the button's space, so revealing it shifts nothing. */}
          <button type="button" class="botao-primario invisible mt-4 w-full sm:w-auto" data-mapa-carregar>
            <Icone nome="local" class="size-5 shrink-0" />
            <span data-mapa-rotulo>Carregar mapa</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  for (const caixa of document.querySelectorAll<HTMLElement>('[data-mapa]')) {
    const fachada = caixa.querySelector<HTMLElement>('[data-mapa-fachada]');
    const botao = caixa.querySelector<HTMLButtonElement>('[data-mapa-carregar]');
    if (!fachada || !botao) continue;
    botao.classList.remove('invisible');
    botao.addEventListener(
      'click',
      () => {
        botao.setAttribute('aria-disabled', 'true');
        const rotulo = botao.querySelector('[data-mapa-rotulo]');
        if (rotulo) rotulo.textContent = 'Carregando mapa...';
        const iframe = document.createElement('iframe');
        iframe.src = caixa.dataset.mapa!;
        iframe.title = caixa.dataset.mapaTitulo!;
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.className = 'absolute inset-0 size-full border-0';
        // The placeholder stays on top until the map has loaded; keyboard focus then moves into it.
        iframe.addEventListener('load', () => {
          const tinhaFoco = document.activeElement === botao;
          fachada.remove();
          if (tinhaFoco) iframe.focus();
        });
        caixa.prepend(iframe);
      },
      { once: true },
    );
  }
</script>

<style>
  /* Placeholder drawn in the theme colors: a street grid and two avenues, no image request. */
  .mapa-fachada {
    --linha: color-mix(in srgb, var(--cor-primaria) 10%, transparent);
    --avenida: color-mix(in srgb, var(--cor-primaria) 16%, transparent);
    background-color: var(--cor-cartao);
    background-image:
      linear-gradient(115deg, transparent 44%, var(--avenida) 44%, var(--avenida) 47%, transparent 47%),
      linear-gradient(20deg, transparent 62%, var(--avenida) 62%, var(--avenida) 64.5%, transparent 64.5%),
      linear-gradient(var(--linha) 2px, transparent 2px),
      linear-gradient(90deg, var(--linha) 2px, transparent 2px);
    background-size:
      100% 100%,
      100% 100%,
      3rem 3rem,
      3rem 3rem;
  }
</style>
