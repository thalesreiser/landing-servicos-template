---
import Icone from './Icone.astro';
import TituloSecao from './TituloSecao.astro';
import { ancoraSecao, type SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'convenios'>;
  // Kicker above the title (tema.rotulos), computed in index.astro.
  rotulo?: string | undefined;
}

const { secao, rotulo } = Astro.props;
const idTitulo = `${ancoraSecao(secao)}-titulo`;
---

<section id={ancoraSecao(secao)} class="secao" aria-labelledby={idTitulo}>
  <div class="container-site">
    <TituloSecao id={idTitulo} titulo={secao.titulo} rotulo={rotulo} />
    {secao.texto && <p class="mt-4 max-w-2xl text-lg text-texto-suave">{secao.texto}</p>}
    <ul class="mt-8 flex flex-wrap gap-3" data-revelar-grupo>
      {
        secao.itens.map((item) => (
          <li class="inline-flex items-center gap-2 rounded-botao border border-texto/15 bg-cartao px-4 py-2 font-semibold">
            <Icone nome="check" class="size-4 text-destaque" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
