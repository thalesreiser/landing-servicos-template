---
import Base from '../layouts/Base.astro';
import Rodape from '../components/Rodape.astro';
import { Content } from '../../politica-de-privacidade.md';
import { carregarNicho } from '../lib/nicho.ts';

const nicho = carregarNicho();
const rodape = nicho.secoes.find((secao) => secao.tipo === 'rodape' && secao.ativo);
---

<Base
  nicho={nicho}
  titulo={`Política de privacidade | ${nicho.site.nome}`}
  descricao={`Como ${nicho.site.nome} trata os dados pessoais enviados por este site.`}
>
  <article class="secao container-site prose-politica max-w-3xl">
    <h1 class="titulo-secao">Política de privacidade</h1>
    <p class="mt-4 text-texto-suave">
      Responsável pelo tratamento: <strong>{nicho.site.nome}</strong>. Contato:
      <a href={`mailto:${nicho.contato.email}`} class="text-primaria underline">{nicho.contato.email}</a>.
    </p>
    <Content />
  </article>
  <Fragment slot="depois">
    {rodape?.tipo === 'rodape' && <Rodape secao={rodape} nicho={nicho} />}
  </Fragment>
</Base>

<style>
  .prose-politica :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .prose-politica :global(p),
  .prose-politica :global(ul) {
    margin-top: 1rem;
    color: var(--cor-texto-suave);
    line-height: 1.7;
  }

  .prose-politica :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }
</style>
